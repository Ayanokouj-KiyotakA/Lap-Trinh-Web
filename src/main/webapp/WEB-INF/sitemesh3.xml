<sitemesh>
	<!-- decorator="ten_file" duoc tinh tu decorator-prefix mac dinh la
	     "/WEB-INF/decorators/", KHONG duoc ghi full path o day (se bi
	     noi thanh /WEB-INF/decorators/WEB-INF/decorators/... va 404). -->

	<!-- Cac trang chua dang nhap (login, dang ky, xac nhan OTP...) dung layout
	     rieng (khong co navbar) -->
	<mapping path="/login" decorator="guest.jsp" />
	<mapping path="/register" decorator="guest.jsp" />
	<mapping path="/verify-otp" decorator="guest.jsp" />
	<mapping path="/forgot-password" decorator="guest.jsp" />
	<mapping path="/reset-password" decorator="guest.jsp" />

	<!-- Cac duong dan khong phai HTML / khong can trang tri -->
	<mapping path="/image" exclude="true" />
	<mapping path="/waiting" exclude="true" />
	<mapping path="/logout" exclude="true" />

	<!-- Mac dinh: tat ca trang con lai dung layout chinh (navbar Bootstrap) -->
	<mapping path="/*" decorator="main.jsp" />
</sitemesh>
