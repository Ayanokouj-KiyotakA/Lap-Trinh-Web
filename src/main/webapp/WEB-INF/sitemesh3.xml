<sitemesh>
	<!-- decorator="ten_file" duoc tinh tu decorator-prefix mac dinh la
	     "/WEB-INF/decorators/", KHONG duoc ghi full path o day (se bi
	     noi thanh /WEB-INF/decorators/WEB-INF/decorators/... va 404). -->

	<!-- Bai tap 04 - yeu cau 1: tich hop SiteMesh Decorator 3 (1 template
	     Bootstrap duy nhat cho toan bo giao dien: main.jsp co navbar,
	     guest.jsp khong navbar) vao TOAN BO cac trang cua bai tap 03
	     (dang ky/OTP kich hoat, quen mat khau/OTP, danh sach+chi tiet
	     Product cong khai, CRUD Product o admin). Cac trang chua dang
	     nhap (login, dang ky, xac nhan OTP, quen/dat lai mat khau) dung
	     layout rieng (khong co navbar) -->
	<mapping path="/login" decorator="guest.jsp" />
	<mapping path="/register" decorator="guest.jsp" />
	<mapping path="/verify-otp" decorator="guest.jsp" />
	<mapping path="/forgot-password" decorator="guest.jsp" />
	<mapping path="/reset-password" decorator="guest.jsp" />

	<!-- Cac duong dan khong phai HTML / khong can trang tri -->
	<mapping path="/image" exclude="true" />
	<mapping path="/waiting" exclude="true" />
	<mapping path="/logout" exclude="true" />

	<!-- Mac dinh: tat ca trang con lai (bao gom /home, /product,
	     /product/detail, /admin/categories, /admin/products va cac
	     trang CRUD admin cua bai tap 03) dung layout chinh (navbar
	     Bootstrap) -->
	<mapping path="/*" decorator="main.jsp" />
</sitemesh>
